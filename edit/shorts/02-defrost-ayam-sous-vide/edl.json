 "subs": [
  {
   "start": 0.0,
   "end": 1.9,
   "text": "Ini lah ayam yang kita dah"
  },
  {
   "start": 1.9,
   "end": 4.1,
   "text": "defrost."
  },
  {
   "start": 4.48,
   "end": 5.4,
   "text": "Kalau kata you all"
  },
  {
   "start": 5.4,
   "end": 6.8,
   "text": "balik kerja kan,"
  },
  {
   "start": 7.32,
   "end": 8.92,
   "text": "nak bersiap, nak pergi"
  },
  {
   "start": 9.32,
   "end": 10.86,
   "text": "solat apa semua, takut tak"
  },
  {
   "start": 10.86,
   "end": 11.6,
   "text": "sempat kan?"
  },
  {
   "start": 11.9,
   "end": 12.7,
   "text": "K akan gunakan"
  },
  {
   "start": 12.7,
   "end": 13.96,
   "text": "fungsi sous vide."
  },
  {
   "start": 14.4,
   "end": 15.92,
   "text": "Masukkan air lebih kurang"
  },
  {
   "start": 15.92,
   "end": 17.66,
   "text": "dalam 500 ml ataupun"
  },
  {
   "start": 17.66,
   "end": 18.3,
   "text": "satu cawan."
  },
  {
   "start": 18.4,
   "end": 20.1,
   "text": "Lepas tu, letak middle rack,"
  },
  {
   "start": 20.1,
   "end": 21.5,
   "text": "ayam tu di atas middle rack."
  },
  {
   "start": 21.66,
   "end": 23.8,
   "text": "Dan terus sahaja gunakan"
  },
  {
   "start": 23.8,
   "end": 26.3,
   "text": "fungsi sous vide, suhu 80."
  },
  {
   "start": 26.42,
   "end": 28.04,
   "text": "Set je masa satu jam pun"
