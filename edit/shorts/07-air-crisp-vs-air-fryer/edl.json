   "text": "Apa beza fungsi air crisp"
  },
  {
   "start": 1.46,
   "end": 2.86,
   "text": "dengan fungsi air fryer?"
  },
  {
   "start": 2.86,
   "end": 4.55,
   "text": "Kebiasaannya air fryer"
