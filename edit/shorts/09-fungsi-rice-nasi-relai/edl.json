 "subs": [
  {
   "start": 0.2,
   "end": 1.4,
   "text": "Best ke masak nasi dalam"
  },
  {
   "start": 1.4,
   "end": 2.35,
   "text": "Food Engine Cooven?"
  },
  {
   "start": 2.44,
   "end": 3.12,
   "text": "Jawapan K, best."
  },
  {
   "start": 3.58,
   "end": 5.28,
   "text": "Apa yang K nampak perbezaan"
  },
  {
   "start": 5.28,
   "end": 6.56,
   "text": "paling ketara adalah"
  },
  {
   "start": 6.56,
   "end": 7.46,
   "text": "bila kita masak nasi"
  },
  {
   "start": 7.46,
   "end": 8.55,
   "text": "guna Food Engine Cooven,"
  },
  {
   "start": 8.66,
   "end": 10.7,
   "text": "nasi kita jadi relai cantik."
  },
  {
   "start": 10.74,
   "end": 12.19,
   "text": "Dia macam kita masak"
  },
  {
   "start": 12.19,
   "end": 13.5,
   "text": "guna kaedah kukus,"
  },
  {
   "start": 13.5,
   "end": 13.85,
   "text": "tapi sebenarnya"
  },
  {
   "start": 13.85,
   "end": 14.2,
   "text": "kita tak kukus."
  },
  {
   "start": 14.28,
   "end": 15.8,
   "text": "Kita guna kaedah tanak juga."
  },
  {
   "start": 15.98,
   "end": 17.02,
   "text": "Cuma hasil dia tu"
  },
  {
   "start": 17.02,
   "end": 18.3,
   "text": "sangat-sangat cantik."
  },
  {
   "start": 18.38,
   "end": 19.68,
   "text": "Dia tak berketul,"
  },
  {
   "start": 19.68,
   "end": 21.05,
   "text": "dia tak bergumpal."
  },
  {
   "start": 21.14,
   "end": 22.48,
   "text": "Dia memang cantik relai,"
  },
  {
   "start": 22.48,
   "end": 24.1,
   "text": "macam kita guna kaedah kukus."
  },
  {
   "start": 24.42,
   "end": 25.36,
   "text": "Siapa yang suka"
  },
  {
   "start": 25.36,
   "end": 26.42,
   "text": "buat nasi minyak,"
  },
  {
   "start": 26.42,
   "end": 27.55,
   "text": "nasi berperisa,"
  },
  {
   "start": 27.62,
   "end": 28.56,
   "text": "korang cuba masak"
  },
  {
   "start": 28.56,
   "end": 29.44,
   "text": "guna fungsi rice"
  },
  {
   "start": 29.44,
   "end": 30.43,
   "text": "yang ada pada Food"
  },
  {
   "start": 30.43,
   "end": 31.2,
   "text": "Engine Cooven."
  },
  {
   "start": 31.56,
   "end": 33.31,
   "text": "Lepas tu boleh juga masak"
