 "subs": [
  {
   "start": 0.0,
   "end": 1.3,
   "text": "Macam mana kita nak bezakan"
  },
  {
   "start": 1.3,
   "end": 2.64,
   "text": "bila masa nak guna barbecue,"
  },
  {
   "start": 2.64,
   "end": 3.75,
   "text": "bila masa nak guna grill?"
  },
  {
   "start": 3.86,
   "end": 7.66,
   "text": "Dulu kita masak guna"
  },
  {
   "start": 7.66,
   "end": 9.4,
   "text": "pan dekat atas dapur gas,"
  },
  {
   "start": 9.5,
   "end": 10.82,
   "text": "so kita guna grill"
  },
  {
   "start": 10.82,
   "end": 11.7,
   "text": "dekat dalam."
  },
  {
   "start": 12.14,
   "end": 13.5,
   "text": "Kalau dulu kita"
  },
  {
   "start": 13.5,
   "end": 15.04,
   "text": "masak dekat luar,"
  },
  {
   "start": 15.04,
   "end": 17.3,
   "text": "guna barbecue pit, guna arang,"
  },
  {
   "start": 17.44,
   "end": 18.72,
   "text": "so kita guna barbecue"
  },
  {
   "start": 18.72,
   "end": 19.45,
   "text": "dekat dalam."
  },
  {
   "start": 19.54,
   "end": 20.7,
   "text": "Kalau nak bakar ikan,"
  },
  {
   "start": 20.7,
   "end": 21.86,
   "text": "nak guna barbecue ke,"
  },
  {
   "start": 21.86,
   "end": 23.2,
   "text": "nak guna grill, dua-dua boleh."
  },
  {
   "start": 23.68,
   "end": 25.26,
   "text": "Kalau dulu bakar ikan guna"
  },
  {
   "start": 25.26,
   "end": 26.9,
   "text": "arang, so gunalah barbecue."
  },
  {
   "start": 27.0,
   "end": 28.26,
   "text": "Hasil dia akan ada"
  },
  {
   "start": 28.26,
   "end": 29.8,
   "text": "sedikit perbezaan lah."
  },
  {
   "start": 29.92,
   "end": 31.2,
   "text": "Kalau macam barbecue ni,"
  },
  {
   "start": 31.2,
   "end": 32.48,
   "text": "dia akan jadi caramelise"
  },
  {
   "start": 32.48,
   "end": 33.99,
   "text": "sikit dekat luar tu, dia akan"
  },
  {
   "start": 33.99,
   "end": 35.55,
   "text": "ada efek arang-arang tu sikit."
  },
  {
   "start": 35.62,
   "end": 36.86,
   "text": "Dia tak sama sangat"
  },
  {
   "start": 36.86,
   "end": 37.7,
   "text": "dengan grill."
  },
  {
   "start": 37.8,
   "end": 38.55,
   "text": "Tapi kalau kita"
  },
  {
   "start": 38.55,
   "end": 39.3,
   "text": "nak buat steak,"
  },
  {
   "start": 39.5,
   "end": 40.54,
   "text": "so kita akan guna"
  },
  {
   "start": 40.54,
   "end": 41.59,
   "text": "fungsi grill yang"
  },
  {
   "start": 41.59,
   "end": 42.5,
   "text": "ada dekat dalam"
