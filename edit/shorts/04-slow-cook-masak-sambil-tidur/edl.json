 "subs": [
  {
   "start": 0.0,
   "end": 0.75,
   "text": "Fungsi slow cook"
  },
  {
   "start": 0.75,
   "end": 1.4,
   "text": "ni, bayangkan,"
  },
  {
   "start": 1.4,
   "end": 2.85,
   "text": "K boleh masak sambil tidur."
  },
  {
   "start": 2.92,
   "end": 4.34,
   "text": "Hasil slow cook, kalau kita"
  },
  {
   "start": 4.34,
   "end": 5.82,
   "text": "buat sup ke, buat gulai ke,"
  },
  {
   "start": 5.82,
   "end": 6.9,
   "text": "dia jadi macam, ya Allah,"
  },
  {
   "start": 6.9,
   "end": 7.4,
   "text": "sedap dia."
  },
  {
   "start": 7.4,
   "end": 9.42,
   "text": "Tak perlu bahan banyak-banyak,"
  },
  {
   "start": 9.42,
   "end": 10.26,
   "text": "tapi dia boleh"
  },
  {
   "start": 10.26,
   "end": 11.28,
   "text": "extract kemanisan"
  },
  {
   "start": 11.28,
   "end": 11.96,
   "text": "daripada protein yang"
  },
  {
   "start": 11.96,
   "end": 12.6,
   "text": "kita tengah masak tu"
  },
  {
   "start": 12.6,
   "end": 14.42,
   "text": "ke dalam kuah yang"
  },
  {
   "start": 14.42,
   "end": 16.04,
   "text": "kita gunakan. Contoh"
  },
  {
   "start": 16.04,
   "end": 16.8,
   "text": "kita buat sup kan."
  },
  {
   "start": 16.88,
   "end": 18.18,
   "text": "So kita tak perlu letak"
  },
  {
   "start": 18.18,
   "end": 19.56,
   "text": "rempah, tak perlu nak letak"
  },
  {
   "start": 19.56,
   "end": 20.78,
   "text": "tiga sekawan apa semua tu."
  },
  {
   "start": 20.78,
   "end": 21.8,
   "text": "Tak payah letak. Betul-betul"
  },
  {
   "start": 21.8,
   "end": 23.4,
   "text": "daging atau ayam semata-mata."
  },
  {
   "start": 23.4,
   "end": 25.2,
   "text": "Tapi nanti hasil akhir"
  },
  {
   "start": 25.2,
   "end": 26.66,
   "text": "dia punya rasa"
  },
  {
   "start": 26.66,
   "end": 27.8,
   "text": "sup tu dia manis."
  },
  {
   "start": 27.9,
   "end": 28.8,
   "text": "Manis datang daripada"
  },
  {
   "start": 28.8,
   "end": 29.96,
   "text": "mana? Daripada protein"
  },
  {
   "start": 29.96,
   "end": 30.5,
   "text": "yang kita gunakan."
  },
  {
   "start": 30.58,
   "end": 31.63,
   "text": "That's why kalau kita"
  },
  {
   "start": 31.63,
   "end": 32.58,
   "text": "nak guna slow cook,"
  },
  {
   "start": 32.68,
   "end": 33.58,
   "text": "betul sangat-sangat"
  },
  {
   "start": 33.58,
   "end": 35.54,
   "text": "korang guna ayam ataupun"
  },
  {
   "start": 35.54,
   "end": 36.64,
   "text": "daging ataupun tulang"
  },
  {
   "start": 36.64,
   "end": 37.9,
   "text": "yang fresh, yang segar."
  },
  {
   "start": 38.0,
   "end": 38.82,
   "text": "Korang boleh masak"
  },
  {
   "start": 38.82,
   "end": 40.2,
   "text": "malam nanti sebelum tidur."
  },
  {
   "start": 40.26,
   "end": 41.84,
   "text": "Masukkan semua bahan,"
  },
  {
   "start": 41.92,
   "end": 43.06,
   "text": "lepas tu set je slow cook,"
  },
  {
   "start": 43.14,
   "end": 44.0,
   "text": "lepas tu korang tidur."
  },
  {
   "start": 44.12,
   "end": 45.8,
   "text": "Esok pagi korang bangun,"
  },
  {
   "start": 45.88,
   "end": 47.36,
   "text": "sup korang tu dah ready"
  },
  {
   "start": 47.36,
   "end": 48.0,
   "text": "untuk dimakan."
  }
 ],
