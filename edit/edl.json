 "subs": [
  {
   "start": 0.05,
   "end": 1.5,
   "text": "Ini hasil dia"
  },
  {
   "start": 1.5,
   "end": 2.48,
   "text": "macam nasi goreng"
  },
  {
   "start": 2.48,
   "end": 3.24,
   "text": "yang kita goreng"
  },
  {
   "start": 3.24,
   "end": 4.3,
   "text": "dekat dalam kuali."
  },
  {
   "start": 4.38,
   "end": 5.85,
   "text": "Kadang-kadang kita balik kerja,"
  },
  {
   "start": 5.9,
   "end": 7.66,
   "text": "nasi nak masak nasi malas,"
  },
  {
   "start": 7.66,
   "end": 8.44,
   "text": "tapi kita nak buat"
  },
  {
   "start": 8.44,
   "end": 9.62,
   "text": "nasi goreng ke apa kan?"
  },
  {
   "start": 9.66,
   "end": 11.2,
   "text": "Tapi nasi sejuk tak ada."
  },
  {
   "start": 11.24,
   "end": 12.52,
   "text": "Kita letak bawang Holland"
  },
  {
   "start": 12.52,
   "end": 13.32,
   "text": "setengah biji."
  },
  {
   "start": 13.36,
   "end": 14.92,
   "text": "Letakkan minyak."
  },
  {
   "start": 14.98,
   "end": 16.72,
   "text": "Letakkan 50 gram."
  },
  {
   "start": 16.84,
   "end": 17.95,
   "text": "Jadikan telur ni"
  },
  {
   "start": 17.95,
   "end": 19.45,
   "text": "sebagai scramble."
  },
  {
   "start": 19.52,
   "end": 20.26,
   "text": "Kita akan gunakan"
  },
  {
   "start": 20.26,
   "end": 22.62,
   "text": "2 sudu besar sos tiram."
  },
  {
   "start": 22.72,
   "end": 24.74,
   "text": "Lepas tu 1 sudu besar"
  },
  {
   "start": 24.74,
   "end": 26.6,
   "text": "light soy sauce."
  },
  {
   "start": 26.7,
   "end": 28.4,
   "text": "Sukatan air adalah"
  },
  {
   "start": 28.4,
   "end": 30.48,
   "text": "450 gram"
  },
  {
   "start": 30.48,
   "end": 32.24,
   "text": "untuk 300 gram"
  },
  {
   "start": 32.24,
   "end": 33.34,
   "text": "beras basmati."
  },
  {
   "start": 33.42,
   "end": 35.3,
   "text": "Lepas tu kita masukkan"
  },
  {
   "start": 35.3,
   "end": 36.08,
   "text": "kita punya beras"
  },
  {
   "start": 36.08,
   "end": 36.95,
   "text": "yang dah dicuci."
  },
  {
   "start": 37.24,
   "end": 38.85,
   "text": "Tak perlu rendam beras ni."
  },
  {
   "start": 39.12,
   "end": 40.6,
   "text": "Kita tutup guna"
  },
  {
   "start": 40.6,
   "end": 41.55,
   "text": "penutup kaca."
  },
  {
   "start": 41.64,
   "end": 43.35,
   "text": "So, smart cook 25 minit."
  },
  {
   "start": 43.56,
   "end": 44.84,
   "text": "Tukar penutup kepada"
  },
  {
   "start": 44.84,
   "end": 46.5,
   "text": "penutup air fryer."
  },
  {
   "start": 46.58,
   "end": 47.64,
   "text": "Dia tak adalah,"
  },
  {
   "start": 47.64,
   "end": 48.72,
   "text": "kata orang tu berkerak ke."
  },
  {
   "start": 48.72,
   "end": 49.88,
   "text": "Dia cantik je lah."
  },
  {
   "start": 49.98,
   "end": 50.78,
   "text": "So, kita akan tukar"
  },
  {
   "start": 50.78,
   "end": 52.86,
   "text": "temperature 240."
  },
  {
   "start": 52.9,
   "end": 53.98,
   "text": "Time 5 minit je."
  },
  {
   "start": 54.34,
   "end": 55.06,
   "text": "Tak perlu nak ada"
  },
  {
   "start": 55.06,
   "end": 56.08,
   "text": "nasi sejuk pun"
  },
  {
   "start": 56.08,
   "end": 57.36,
   "text": "nak buat nasi goreng."
  },
  {
   "start": 57.36,
   "end": 59.15,
   "text": "Tapi rasa dia sama."
  }
 ],
