  {
   "start": 13.52,
   "end": 15.28,
   "text": "tidur tanpa kita fikir apa"
  },
  {
   "start": 15.28,
   "end": 16.46,
   "text": "benda yang ada dekat dapur."
  },
  {
   "start": 16.66,
   "end": 17.9,
   "text": "Haa tanpa kita fikir eh tadi"
  },
  {
   "start": 17.9,
   "end": 19.16,
   "text": "aku masak aku dah tutup ke"
  },
  {
   "start": 19.16,
   "end": 20.38,
   "text": "belum api, tak payah fikir."
  },
  {
   "start": 20.56,
   "end": 22.46,
   "text": "Sebab bila kita gunakan fungsi"
  },
  {
   "start": 22.46,
   "end": 23.98,
   "text": "slow cook ni dia akan masak"
  },
  {
   "start": 23.98,
   "end": 25.6,
   "text": "masakan kita tu dengan perlahan"
  },
  {
   "start": 25.6,
   "end": 28.62,
   "text": "tapi dia akan keluarkan semua"
  },
  {
   "start": 28.827,
   "end": 30.407,
   "text": "jus-jus yang ada dekat"
  },
  {
   "start": 30.407,
   "end": 31.587,
   "text": "dalam masakan kita tu."
  },
  {
   "start": 31.647,
   "end": 32.707,
   "text": "Maksudnya kita punya"
  },
  {
   "start": 32.707,
   "end": 34.347,
   "text": "masakan tu dia akan jadi"
  },
  {
   "start": 34.347,
   "end": 36.027,
   "text": "original punya rasa tau."
  },
  {
   "start": 36.227,
   "end": 37.327,
   "text": "Contoh kan, Kak nak"
  },
  {
   "start": 37.327,
   "end": 38.367,
   "text": "bawa bekal anak esok,"
  },
  {
   "start": 38.56,
