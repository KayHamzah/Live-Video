   "text": "Fungsi slow cook ni pun antara"
  },
  {
   "start": 1.247,
   "end": 2.94,
   "text": "fungsi yang K suka sebab apa?"
  },
  {
   "start": 3.127,
   "end": 3.907,
   "text": "Sebab kita boleh"
  },
  {
   "start": 3.907,
   "end": 4.867,
   "text": "masak sambil tidur."
  },
  {
   "start": 5.06,
