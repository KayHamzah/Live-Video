   "text": "tidur tanpa kita fikir apa"
  },
  {
   "start": 15.96,
   "end": 17.14,
   "text": "benda yang ada dekat dapur."
  },
  {
   "start": 17.327,
   "end": 18.567,
   "text": "Haa tanpa kita fikir eh tadi"
  },
  {
   "start": 18.567,
   "end": 19.827,
   "text": "aku masak aku dah tutup ke"
  },
  {
   "start": 19.827,
   "end": 21.047,
   "text": "belum api, tak payah fikir."
  },
  {
   "start": 21.227,
   "end": 23.127,
   "text": "Sebab bila kita gunakan fungsi"
  },
  {
   "start": 23.127,
   "end": 24.647,
   "text": "slow cook ni dia akan masak"
