  {
   "start": 0.06,
   "end": 1.247,
   "text": "Fungsi slow cook ni pun antara"
  },
  {
   "start": 1.247,
   "end": 2.94,
   "text": "fungsi yang K suka sebab apa?"
  },
  {
   "start": 3.127,
   "end": 3.907,
   "text": "Sebab kita boleh"
  },
  {
   "start": 3.907,
   "end": 4.867,
   "text": "masak sambil tidur."
  },
  {
   "start": 5.06,
   "end": 6.2,
   "text": "Kita boleh masak sambil tidur,"
  },
  {
   "start": 6.36,
   "end": 7.22,
   "text": "kita boleh masak sambil"
  },
  {
   "start": 7.22,
   "end": 8.345,
   "text": "bersembang dengan jiran"
  },
  {
   "start": 8.345,
   "end": 9.68,
   "text": "sebelah, kita boleh masak sambil"
  },
  {
   "start": 9.68,
   "end": 10.8,
   "text": "main dengan anak-anak, kita"
  },
  {
   "start": 10.8,
   "end": 11.94,
   "text": "boleh masak sambil kita"
  },
  {
   "start": 11.94,
   "end": 13.52,
   "text": "mengaji, lepas tu kita boleh"
