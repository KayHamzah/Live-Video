 "subtitles": [
  {
   "start": 0.06,
   "end": 1.72,
   "text": "Lepas tu kita juga"
  },
  {
   "start": 1.72,
   "end": 3.4,
   "text": "ada fungsi air crisp."
  },
  {
   "start": 3.44,
   "end": 4.5,
   "text": "Fungsi air crisp."
  },
  {
   "start": 4.5,
   "end": 6.52,
   "text": "Ni dia similar kepada"
  },
  {
   "start": 6.52,
   "end": 8.12,
   "text": "fungsi air fryer."
  },
  {
   "start": 8.327,
   "end": 8.667,
   "text": "Kan."
  },
  {
   "start": 8.86,
   "end": 10.68,
   "text": "Tapi apa yang tak sama?"
  },
  {
   "start": 10.84,
   "end": 12.16,
   "text": "Mesti ada perbezaan betul tak?"
  },
  {
   "start": 12.327,
   "end": 14.027,
   "text": "Perbezaannya adalah bila"
  },
  {
   "start": 14.027,
   "end": 16.227,
   "text": "kita gunakan fungsi Cooven,"
  },
  {
   "start": 16.427,
   "end": 18.447,
   "text": "air crisp kita ni ayam"
  },
  {
   "start": 18.447,
   "end": 20.187,
   "text": "ataupun ikan yang kita goreng"
  },
  {
   "start": 20.187,
   "end": 21.247,
   "text": "menggunakan fungsi air"
  },
  {
   "start": 21.247,
   "end": 22.907,
   "text": "crisp ni dia lebih juicy."
  },
  {
   "start": 23.093,
   "end": 23.953,
   "text": "Dia tidak kering."
  },
  {
   "start": 24.173,
   "end": 25.213,
   "text": "Dia tak sama macam kita"
  },
  {
   "start": 25.213,
   "end": 26.113,
   "text": "goreng dalam air fryer."
  },
  {
   "start": 26.253,
   "end": 27.473,
   "text": "Kalau dalam air fryer tu"
  },
  {
   "start": 27.473,
   "end": 29.093,
   "text": "ayam tu dia akan dry."
  },
  {
   "start": 29.253,
   "end": 29.793,
   "text": "Kita kena letak"
  },
  {
   "start": 29.793,
   "end": 30.673,
   "text": "minyak yang banyak."
  },
  {
   "start": 30.913,
   "end": 31.973,
   "text": "Lepas tu kejap-kejap kita"
  },
  {
   "start": 31.973,
   "end": 33.613,
   "text": "kena buka letak minyak ataupun"
  },
  {
   "start": 33.613,
   "end": 34.693,
   "text": "ada satu lagi cara nak"
  },
  {
   "start": 34.693,
   "end": 35.713,
   "text": "hack kita kena letak air"
  },
  {
   "start": 35.713,
   "end": 37.193,
   "text": "satu mangkuk ataupun air dekat"
  },
  {
   "start": 37.193,
   "end": 38.373,
   "text": "bawah dia punya penapis."
  },
  {
   "start": 38.56,
   "end": 40.88,
   "text": "Hasil dia nanti semacam"
  },
  {
   "start": 40.88,
   "end": 42.4,
   "text": "kita deep fry, tapi"
  },
  {
   "start": 42.4,
   "end": 43.46,
   "text": "kita tak deep fry."
  },
  {
   "start": 43.66,
   "end": 45.6,
   "text": "Boleh goreng keropok"
  },
  {
   "start": 45.6,
   "end": 46.86,
   "text": "tanpa menggunakan minyak."
  },
  {
   "start": 46.96,
   "end": 47.86,
   "text": "Contoh macam papadum,"
  },
  {
   "start": 48.06,
   "end": 48.12,
   "text": "kan?"
  },
  {
   "start": 48.34,
   "end": 49.22,
   "text": "Kita nak buat popcorn."
  },
  {
   "start": 49.52,
   "end": 50.96,
   "text": "Yang tu semua kita boleh gunakan"
  },
  {
   "start": 50.96,
   "end": 52.18,
   "text": "fungsi air crisp ni tadi."
  },
  {
   "start": 52.36,
   "end": 53.34,
   "text": "Banyaklah benda yang kita"
  },
  {
   "start": 53.34,
   "end": 54.22,
   "text": "boleh guna fungsi air crisp."
  },
  {
   "start": 54.3,
   "end": 55.46,
   "text": "Ataupun kita nak goreng nugget"
  },
  {
   "start": 55.46,
   "end": 56.72,
   "text": "ke, nak goreng kentang ke,"
  },
  {
   "start": 56.9,
   "end": 58.14,
   "text": "nak goreng keropok lekor ke."
  },
  {
   "start": 58.44,
   "end": 59.6,
   "text": "Yang tu pun selalu kita"
  },
  {
   "start": 59.6,
   "end": 60.86,
   "text": "akan guna fungsi air crisp."
  }
 ],
