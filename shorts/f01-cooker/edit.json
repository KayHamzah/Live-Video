 "subtitles": [
  {
   "start": 0.06,
   "end": 0.947,
   "text": "Okay, so fungsi yang"
  },
  {
   "start": 0.947,
   "end": 2.547,
   "text": "pertama yang ada pada Cooven"
  },
  {
   "start": 2.547,
   "end": 4.207,
   "text": "adalah fungsi cooker."
  },
  {
   "start": 4.393,
   "end": 5.813,
   "text": "Fungsi cooker ni fungsi apa?"
  },
  {
   "start": 6.013,
   "end": 7.073,
   "text": "Fungsi cooker ni dia"
  },
  {
   "start": 7.073,
   "end": 8.913,
   "text": "sama macam kita masak"
  },
  {
   "start": 8.913,
   "end": 9.953,
   "text": "menggunakan dapur gas,"
  },
  {
   "start": 10.127,
   "end": 11.067,
   "text": "kita masak menggunakan"
  },
  {
   "start": 11.067,
   "end": 12.387,
   "text": "induction cooker ataupun"
  },
  {
   "start": 12.387,
   "end": 13.807,
   "text": "apa-apa multi cooker yang"
  },
  {
   "start": 13.807,
   "end": 14.887,
   "text": "korang ada dekat rumah tu."
  },
  {
   "start": 15.087,
   "end": 16.807,
   "text": "Dia boleh gantikan ke semua"
  },
  {
   "start": 16.807,
   "end": 17.967,
   "text": "fungsi-fungsi tu tadi."
  },
  {
   "start": 18.16,
   "end": 19.48,
   "text": "Okay, paling senang"
  },
  {
   "start": 19.48,
   "end": 20.38,
   "text": "kita cakap dia boleh"
  },
  {
   "start": 20.38,
   "end": 21.42,
   "text": "gantikan dapur gas lah."
  },
  {
   "start": 21.627,
   "end": 22.907,
   "text": "Sebab tu dekat rumah K"
  },
  {
   "start": 22.907,
   "end": 24.047,
   "text": "pun dah takde dapur gas."
  },
  {
   "start": 24.227,
   "end": 25.967,
   "text": "Sebab hari tu lepas beli"
  },
  {
   "start": 25.967,
   "end": 27.267,
   "text": "Cooven ni dapur gas rosak."
  },
  {
   "start": 27.387,
   "end": 28.127,
   "text": "Jadi memang K takde"
  },
  {
   "start": 28.127,
   "end": 28.807,
   "text": "dapur gas dah lah."
  },
  {
   "start": 28.947,
   "end": 30.147,
   "text": "Sebab tu K akan masak"
  },
  {
   "start": 30.147,
   "end": 31.007,
   "text": "memang 100% dengan"
  },
  {
   "start": 31.007,
   "end": 32.827,
   "text": "menggunakan Cooven sahaja."
  },
  {
   "start": 32.993,
   "end": 34.673,
   "text": "Okey so untuk fungsi cooker"
  },
  {
   "start": 34.673,
   "end": 36.593,
   "text": "kita boleh adjust suhu tau."
  },
  {
   "start": 36.753,
   "end": 38.733,
   "text": "Kita ada suhu dan juga masa"
  },
  {
   "start": 38.733,
   "end": 40.113,
   "text": "yang kita boleh adjust."
  },
  {
   "start": 40.373,
   "end": 41.813,
   "text": "Kalau kata fungsi cooker ni"
  },
  {
   "start": 41.813,
   "end": 42.973,
   "text": "kita boleh adjust daripada"
  },
  {
   "start": 42.973,
   "end": 46.113,
   "text": "suhu 40 sehingga suhu 240."
  },
  {
   "start": 46.293,
   "end": 47.613,
   "text": "Masa pula kita boleh"
  },
  {
   "start": 47.613,
   "end": 48.613,
   "text": "adjust daripada 1"
  },
  {
   "start": 48.613,
   "end": 50.573,
   "text": "minit sehingga 10 jam."
  },
  {
   "start": 50.76,
   "end": 51.48,
   "text": "Haa kan."
  },
  {
   "start": 51.76,
   "end": 52.74,
   "text": "So kita nak masak apa"
  },
  {
   "start": 52.74,
   "end": 53.6,
   "text": "sampai 10 jam tu?"
  },
  {
   "start": 53.793,
   "end": 55.113,
   "text": "Tak tahu nak masak apa eh."
  }
