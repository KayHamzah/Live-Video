 "subtitles": [
  {
   "start": 0.06,
   "end": 1.0,
   "text": "Bukan kerja masak"
  },
  {
   "start": 1.0,
   "end": 1.52,
   "text": "tu yang penat."
  },
  {
   "start": 1.66,
   "end": 3.14,
   "text": "Tapi penatnya adalah kerja"
  },
  {
   "start": 3.14,
   "end": 4.36,
   "text": "mengemas selepas masak tu."
  },
  {
   "start": 4.56,
   "end": 6.04,
   "text": "So sebelum nak bakar ayam,"
  },
  {
   "start": 6.22,
   "end": 7.66,
   "text": "kita ni kan jenis tak berapa"
  },
  {
   "start": 7.66,
   "end": 9.54,
   "text": "nak rajin membasuh kan."
  },
  {
   "start": 9.727,
   "end": 11.927,
   "text": "You all ada baking paper kan?"
  },
  {
   "start": 12.093,
   "end": 13.273,
   "text": "So you all letak je baking"
  },
  {
   "start": 13.273,
   "end": 14.393,
   "text": "paper ni kat dalam ni."
  },
  {
   "start": 14.56,
   "end": 16.66,
   "text": "Jadi untuk kita masak-masak ke"
  },
  {
   "start": 16.66,
   "end": 18.2,
   "text": "apa tak perlu lah kita nak"
  },
  {
   "start": 18.2,
   "end": 20.1,
   "text": "basuh kita punya inner pot ni."
  },
  {
   "start": 20.293,
   "end": 21.593,
   "text": "Ha tak payahlah kita"
  },
  {
   "start": 21.593,
   "end": 22.573,
   "text": "nak basuh beria, nak"
  },
  {
   "start": 22.573,
   "end": 23.913,
   "text": "menyental beria semua tu."
  },
  {
   "start": 24.073,
   "end": 25.573,
   "text": "Kita lapikkan sahaja kita"
  },
  {
   "start": 25.573,
   "end": 27.213,
   "text": "punya baking paper macam ni."
  },
  {
   "start": 27.393,
   "end": 28.473,
   "text": "Nampak tak kita angkat"
  },
  {
   "start": 28.473,
   "end": 29.593,
   "text": "seketul macam ni terus"
  },
  {
   "start": 29.593,
   "end": 30.653,
   "text": "letak dekat sinki."
  },
  {
   "start": 30.827,
   "end": 32.047,
   "text": "So takdalah kita punya"
  },
  {
   "start": 32.047,
   "end": 33.307,
   "text": "inner pot ni kotor."
  }
 ],
