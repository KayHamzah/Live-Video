 "subtitles": [
  {
   "start": 0.06,
   "end": 1.02,
   "text": "So itu adalah fungsi yang"
  },
  {
   "start": 1.02,
   "end": 2.04,
   "text": "terakhirlah, fungsi oven."
  },
  {
   "start": 2.26,
   "end": 3.2,
   "text": "So fungsi oven ni"
  },
  {
   "start": 3.2,
   "end": 4.2,
   "text": "untuk masak apa ke?"
  },
  {
   "start": 4.4,
   "end": 6.58,
   "text": "Fungsi oven ni macam mana kita"
  },
  {
   "start": 6.58,
   "end": 8.52,
   "text": "gunakan oven yang sebelum ni,"
  },
  {
   "start": 8.693,
   "end": 9.673,
   "text": "macam tu jugalah kita"
  },
  {
   "start": 9.673,
   "end": 10.533,
   "text": "gunakan dekat sini."
  },
  {
   "start": 10.693,
   "end": 11.673,
   "text": "Kita boleh bakar kek,"
  },
  {
   "start": 11.973,
   "end": 12.873,
   "text": "kita boleh bakar roti,"
  },
  {
   "start": 13.153,
   "end": 14.533,
   "text": "kita boleh bakar sourdough,"
  },
  {
   "start": 14.727,
   "end": 16.587,
   "text": "kita boleh bakar scone,"
  },
  {
   "start": 16.793,
   "end": 17.773,
   "text": "kita boleh bakar pastry,"
  },
  {
   "start": 17.96,
   "end": 18.9,
   "text": "semua tu kita boleh bakar"
  },
  {
   "start": 18.9,
   "end": 20.2,
   "text": "dengan menggunakan fungsi oven."
  },
  {
   "start": 20.393,
   "end": 21.673,
   "text": "Ada pinggan macam ni"
  },
  {
   "start": 21.673,
   "end": 23.013,
   "text": "ataupun mangkuk ke kan."
  },
  {
   "start": 23.193,
   "end": 24.853,
   "text": "Mangkuk ni kita letak ayam,"
  },
  {
   "start": 25.073,
   "end": 26.613,
   "text": "kita letak kuah apa semua kan."
  },
  {
   "start": 26.713,
   "end": 27.653,
   "text": "Katalah kita letak ibu"
  },
  {
   "start": 27.653,
   "end": 29.013,
   "text": "sambal, letak ayam semua."
  },
  {
   "start": 29.193,
   "end": 30.773,
   "text": "Lepas tu kita letak sekali"
  },
  {
   "start": 30.773,
   "end": 31.973,
   "text": "dengan mangkuk-mangkuk ni dekat"
  },
  {
   "start": 31.973,
   "end": 33.373,
   "text": "dalam kita punya inner pot."
  },
  {
   "start": 33.493,
   "end": 35.093,
   "text": "Kita boleh gunakan fungsi oven"
  },
  {
   "start": 35.093,
   "end": 36.533,
   "text": "juga untuk masak masakan"
  },
  {
   "start": 36.533,
   "end": 37.713,
   "text": "kita dekat dalam bekas lain."
  },
  {
   "start": 37.893,
   "end": 39.153,
   "text": "So kita tak perlu basuh dah"
  },
  {
   "start": 39.153,
   "end": 41.593,
   "text": "kita punya inner pot tu tadi."
  },
  {
   "start": 41.793,
   "end": 43.193,
   "text": "Maksudnya macam kita masak"
  },
  {
   "start": 43.193,
   "end": 45.113,
   "text": "benda dalam periuk kecil"
  },
  {
   "start": 45.113,
   "end": 46.073,
   "text": "tapi periuk kecil tu kita"
  },
  {
   "start": 46.073,
   "end": 47.553,
   "text": "masukkan dekat dalam Cooven."
  }
 ],
