 "subtitles": [
  {
   "start": 0.06,
   "end": 0.96,
   "text": "Oven."
  },
  {
   "start": 1.18,
   "end": 2.14,
   "text": "So itu adalah fungsi yang"
  },
  {
   "start": 2.14,
   "end": 3.16,
   "text": "terakhirlah, fungsi oven."
  },
  {
   "start": 3.38,
   "end": 4.32,
   "text": "So fungsi oven ni"
  },
  {
   "start": 4.32,
   "end": 5.32,
   "text": "untuk masak apa ke?"
  },
  {
   "start": 5.52,
   "end": 7.7,
   "text": "Fungsi oven ni macam mana kita"
  },
  {
   "start": 7.7,
   "end": 9.64,
   "text": "gunakan oven yang sebelum ni,"
  },
  {
   "start": 9.827,
   "end": 10.807,
   "text": "macam tu jugalah kita"
  },
  {
   "start": 10.807,
   "end": 11.667,
   "text": "gunakan dekat sini."
  },
  {
   "start": 11.827,
   "end": 12.807,
   "text": "Kita boleh bakar ke?"
  },
  {
   "start": 13.107,
   "end": 14.007,
   "text": "Kita boleh bakar roti,"
  },
  {
   "start": 14.287,
   "end": 15.667,
   "text": "kita boleh bakar sourdough,"
  },
  {
   "start": 15.86,
   "end": 17.72,
   "text": "kita boleh bakar scone,"
  },
  {
   "start": 17.927,
   "end": 18.907,
   "text": "kita boleh bakar pastry,"
  },
  {
   "start": 19.093,
   "end": 20.033,
   "text": "semua tu kita boleh bakar"
  },
  {
   "start": 20.033,
   "end": 21.333,
   "text": "dengan menggunakan fungsi oven."
  },
  {
   "start": 21.527,
   "end": 22.807,
   "text": "Ada pinggan macam ni"
  },
  {
   "start": 22.807,
   "end": 24.147,
   "text": "ataupun mangkuk ke kan."
  },
  {
   "start": 24.327,
   "end": 24.747,
   "text": "Mangkuk."
  },
  {
   "start": 24.927,
   "end": 26.587,
   "text": "Mangkuk ni kita letak ayam,"
  },
  {
   "start": 26.807,
   "end": 28.347,
   "text": "kita letak kuah apa semua kan."
  },
  {
   "start": 28.447,
   "end": 29.387,
   "text": "Katalah kita letak ibu"
  },
  {
   "start": 29.387,
   "end": 30.747,
   "text": "sambal, letak ayam semua."
  },
  {
   "start": 30.927,
   "end": 32.507,
   "text": "Lepas tu kita letak sekali"
  },
  {
   "start": 32.507,
   "end": 33.707,
   "text": "dengan mangkuk-mangkuk ni dekat"
  },
  {
   "start": 33.707,
   "end": 35.107,
   "text": "dalam kita punya inner pot."
  },
  {
   "start": 35.227,
   "end": 36.827,
   "text": "Kita boleh gunakan fungsi oven"
  },
  {
   "start": 36.827,
   "end": 38.267,
   "text": "juga untuk masak masakan"
  },
  {
   "start": 38.267,
   "end": 39.447,
   "text": "kita dekat dalam bekas lain."
  },
  {
   "start": 39.627,
   "end": 40.887,
   "text": "So kita tak perlu basuh dah"
  },
  {
   "start": 40.887,
   "end": 43.327,
   "text": "kita punya inner pot tu tadi."
  },
  {
   "start": 43.527,
   "end": 44.927,
   "text": "Maksudnya macam kita masak"
  },
  {
   "start": 44.927,
   "end": 47.007,
   "text": "benda dalam periuk kecil tapi"
  },
  {
   "start": 47.007,
   "end": 48.287,
   "text": "periuk kecil tu kita masukkan"
  },
  {
   "start": 48.287,
   "end": 49.287,
   "text": "dekat dalam Cooven cooker."
  }
 ],
