 "subtitles": [
  {
   "start": 0.06,
   "end": 2.16,
   "text": "Nampak tak ayam kita dah siap?"
  },
  {
   "start": 2.36,
   "end": 3.74,
   "text": "Kenapa dia kata ayam"
  },
  {
   "start": 3.74,
   "end": 5.0,
   "text": "ni gelap, hitam?"
  },
  {
   "start": 5.193,
   "end": 5.633,
   "text": "Hangit ke?"
  },
  {
   "start": 5.813,
   "end": 6.693,
   "text": "Tak, dia bukan hangit,"
  },
  {
   "start": 6.833,
   "end": 7.553,
   "text": "dia caramelise."
  },
  {
   "start": 7.753,
   "end": 8.273,
   "text": "Sebab apa?"
  },
  {
   "start": 8.413,
   "end": 10.473,
   "text": "Sebab pertama kita guna kicap,"
  },
  {
   "start": 10.66,
   "end": 11.22,
   "text": "lepas tu kita"
  },
  {
   "start": 11.22,
   "end": 12.32,
   "text": "guna brown sugar."
  },
  {
   "start": 12.527,
   "end": 15.147,
   "text": "So bila dua bahan ni"
  },
  {
   "start": 15.147,
   "end": 17.567,
   "text": "bergabung, lepas tu dia kena"
  },
  {
   "start": 17.567,
   "end": 19.367,
   "text": "suhu yang tinggi, dia memang"
  },
  {
   "start": 19.367,
   "end": 20.487,
   "text": "akan nampak hitam tau."
  },
  {
   "start": 20.567,
   "end": 21.567,
   "text": "Tapi dia pahit ke tak?"
  },
  {
   "start": 21.767,
   "end": 22.587,
   "text": "Tak, dia tak pahit."
  },
  {
   "start": 22.793,
   "end": 25.113,
   "text": "Dia punya kulit ni"
  },
  {
   "start": 25.113,
   "end": 26.953,
   "text": "dia jadi crunchy tau."
  },
  {
   "start": 27.16,
   "end": 28.56,
   "text": "Haa dia tak dry."
  },
  {
   "start": 28.76,
   "end": 30.22,
   "text": "Okey dan dia tak pahit."
  },
  {
   "start": 30.5,
   "end": 31.46,
   "text": "Haa itu yang penting."
  },
  {
   "start": 31.627,
   "end": 32.647,
   "text": "Kalau kita bakar dalam oven,"
  },
  {
   "start": 32.807,
   "end": 33.887,
   "text": "gelap macam ni, dia pahit."
  },
  {
   "start": 34.093,
   "end": 35.133,
   "text": "Tapi kita bakar dalam"
  },
  {
   "start": 35.133,
   "end": 36.273,
   "text": "Cooven, dia tak pahit."
  }
 ],
