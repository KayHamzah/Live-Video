  {
   "start": 0.06,
   "end": 1.82,
   "text": "Fungsi pizza ni adalah"
  },
  {
   "start": 1.82,
   "end": 2.84,
   "text": "antara fungsi yang"
  },
  {
   "start": 2.84,
   "end": 3.76,
   "text": "paling kita suka juga."
  },
  {
   "start": 3.96,
   "end": 4.32,
   "text": "Sebab apa?"
  },
  {
   "start": 4.46,
   "end": 5.56,
   "text": "Sebab kita boleh bakar"
  },
  {
   "start": 5.56,
   "end": 6.84,
   "text": "pizza secepat 6 minit."
  },
  {
   "start": 7.027,
   "end": 8.147,
   "text": "Lepas tu you all boleh buat lah"
  },
  {
   "start": 8.147,
   "end": 9.727,
   "text": "nak buat jenis New York ke,"
  },
  {
   "start": 10.007,
