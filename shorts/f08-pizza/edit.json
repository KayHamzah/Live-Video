  {
   "start": 12.9,
   "end": 14.16,
   "text": "ke, semua jenis boleh."
  },
  {
   "start": 14.327,
   "end": 15.827,
   "text": "Kalau dulu kita terhad,"
  },
  {
   "start": 16.027,
   "end": 17.567,
   "text": "kita asik-asik kita bakar"
