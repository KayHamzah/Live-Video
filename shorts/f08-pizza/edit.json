  {
   "start": 17.567,
   "end": 18.607,
   "text": "pizza roti, pizza roti,"
  },
  {
   "start": 18.667,
   "end": 19.587,
   "text": "pizza roti, you know tak?"
  },
  {
   "start": 19.76,
   "end": 21.2,
   "text": "Sebab itu je yang kita tahu."
  },
  {
   "start": 21.243,
   "end": 22.543,
   "text": "Kalau nak masak pizza"
  },
  {
   "start": 22.543,
   "end": 23.683,
   "text": "ala-ala Neapolitan tu"
  },
  {
   "start": 23.893,
   "end": 24.253,
