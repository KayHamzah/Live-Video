 "subtitles": [
  {
   "start": 0.06,
   "end": 1.18,
   "text": "Kalau siapa yang buat"
  },
  {
   "start": 1.18,
   "end": 2.22,
   "text": "resepi ni memang"
  },
  {
   "start": 2.22,
   "end": 3.6,
   "text": "akan bau semerbak lah."
  },
  {
   "start": 3.793,
   "end": 5.413,
   "text": "Ok satu rumah bau."
  },
  {
   "start": 5.593,
   "end": 9.293,
   "text": "Cara dia adalah mula-mula"
  },
  {
   "start": 9.293,
   "end": 10.993,
   "text": "kita marinade ayam tu"
  },
  {
   "start": 10.993,
   "end": 15.593,
   "text": "dengan barbecue seasoning."
  },
  {
   "start": 15.76,
   "end": 17.44,
   "text": "Lepas letak barbecue"
  },
  {
   "start": 17.44,
   "end": 18.32,
   "text": "seasoning, letaklah"
  },
  {
   "start": 18.32,
   "end": 19.92,
   "text": "dalam 2-3 sudu macam tu."
  },
  {
   "start": 20.093,
   "end": 21.373,
   "text": "Lepas tu letak garam sikit."
  },
  {
   "start": 21.56,
   "end": 23.6,
   "text": "Lepas tu letak minyak sikit"
  },
  {
   "start": 23.793,
   "end": 24.573,
   "text": "letak."
  },
  {
   "start": 24.76,
   "end": 25.92,
   "text": "Lepas tu letak oyster sauce,"
  },
  {
   "start": 26.093,
   "end": 27.033,
   "text": "dark soy sauce,"
  },
  {
   "start": 27.227,
   "end": 28.027,
   "text": "light soy sauce."
  },
  {
   "start": 28.107,
   "end": 29.347,
   "text": "Yang tu kena letak semua tu."
  },
  {
   "start": 29.527,
   "end": 30.787,
   "text": "Lepas tu letak brown sugar"
  },
  {
   "start": 30.787,
   "end": 32.487,
   "text": "sikit ataupun gula kabung Thai."
  },
  {
   "start": 32.66,
   "end": 33.5,
   "text": "Okey lepas dah letak"
  },
  {
   "start": 33.5,
   "end": 34.82,
   "text": "semua tu, gaul-gaul."
  },
  {
   "start": 34.88,
   "end": 35.82,
   "text": "Kita marinate-kan dia."
  },
  {
   "start": 35.92,
   "end": 36.68,
   "text": "At least satu malam"
  },
  {
   "start": 36.68,
   "end": 37.34,
   "text": "lagi sedap lah."
  },
  {
   "start": 37.527,
   "end": 39.107,
   "text": "Tapi kalau buat overnight lagi"
  },
  {
   "start": 39.107,
   "end": 40.087,
   "text": "sedap dia punya rasa sebab"
  },
  {
   "start": 40.087,
   "end": 41.027,
   "text": "dia akan masuk sampai dalam."
  },
  {
   "start": 41.193,
   "end": 42.273,
   "text": "Untuk naikkan dia"
  },
  {
   "start": 42.273,
   "end": 43.473,
   "text": "punya bau smoke tu,"
  },
  {
   "start": 43.66,
   "end": 44.56,
   "text": "letakkan dua"
  },
  {
   "start": 44.56,
   "end": 45.7,
   "text": "batang kayu manis,"
  },
  {
   "start": 45.893,
   "end": 48.833,
   "text": "tiga ketul star anise"
  },
  {
   "start": 48.833,
   "end": 50.713,
   "text": "ataupun bunga lawang,"
  },
  {
   "start": 50.893,
   "end": 51.993,
   "text": "lepas tu satu sudu"
  },
  {
   "start": 51.993,
   "end": 53.253,
   "text": "kecil white peppercorn,"
  },
  {
   "start": 53.427,
   "end": 55.947,
   "text": "lepas tu buah pelaga lebih"
  },
  {
   "start": 55.947,
   "end": 58.707,
   "text": "kurang dalam lima biji macam tu."
  }
 ],
