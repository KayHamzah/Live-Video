 "subtitles": [
  {
   "start": 0.06,
   "end": 1.18,
   "text": "Kalau siapa yang buat"
  },
  {
   "start": 1.18,
   "end": 2.22,
   "text": "resepi ni memang"
  },
  {
   "start": 2.22,
   "end": 3.6,
   "text": "akan bau semerbak lah."
  },
  {
   "start": 3.793,
   "end": 5.413,
   "text": "Ok satu rumah bau."
  },
  {
   "start": 5.593,
   "end": 9.293,
   "text": "Cara dia adalah mula-mula"
  },
  {
   "start": 9.293,
   "end": 10.993,
   "text": "kita marinade ayam tu"
  },
  {
   "start": 10.993,
   "end": 15.593,
   "text": "dengan barbecue seasoning."
  },
  {
   "start": 15.76,
   "end": 17.44,
   "text": "Lepas letak barbecue"
  },
  {
   "start": 17.44,
   "end": 18.32,
   "text": "seasoning, letaklah"
  },
  {
   "start": 18.32,
   "end": 19.92,
   "text": "dalam 2-3 sudu macam tu."
  },
  {
   "start": 20.093,
   "end": 21.373,
   "text": "Lepas tu letak garam sikit."
  },
  {
   "start": 21.56,
   "end": 23.6,
   "text": "Lepas tu letak minyak sikit"
  },
  {
   "start": 23.793,
   "end": 24.953,
   "text": "Lepas tu letak oyster sauce,"
  },
  {
   "start": 25.127,
   "end": 26.067,
   "text": "dark soy sauce,"
  },
  {
   "start": 26.26,
   "end": 27.06,
   "text": "light soy sauce."
  },
  {
   "start": 27.227,
   "end": 28.487,
   "text": "Lepas tu letak brown sugar"
  },
  {
   "start": 28.487,
   "end": 30.187,
   "text": "sikit ataupun gula kabung Thai."
  },
  {
   "start": 30.36,
   "end": 31.1,
   "text": "Lepas dah letak"
  },
  {
   "start": 31.1,
   "end": 32.42,
   "text": "semua tu, gaul-gaul."
  },
  {
   "start": 32.48,
   "end": 33.42,
   "text": "Kita marinate-kan dia."
  },
  {
   "start": 33.52,
   "end": 34.28,
   "text": "At least satu malam"
  },
  {
   "start": 34.28,
   "end": 34.94,
   "text": "lagi sedap lah."
  },
  {
   "start": 35.127,
   "end": 36.707,
   "text": "Tapi kalau buat overnight lagi"
  },
  {
   "start": 36.707,
   "end": 37.687,
   "text": "sedap dia punya rasa sebab"
  },
  {
   "start": 37.687,
   "end": 38.627,
   "text": "dia akan masuk sampai dalam."
  },
  {
   "start": 38.793,
   "end": 39.873,
   "text": "Untuk naikkan dia"
  },
  {
   "start": 39.873,
   "end": 41.073,
   "text": "punya bau smoke tu,"
  },
  {
   "start": 41.26,
   "end": 42.16,
   "text": "letakkan dua"
  },
  {
   "start": 42.16,
   "end": 43.3,
   "text": "batang kayu manis,"
  },
  {
   "start": 43.493,
   "end": 46.433,
   "text": "tiga ketul star anise"
  },
  {
   "start": 46.433,
   "end": 48.313,
   "text": "ataupun bunga lawang,"
  },
  {
   "start": 48.493,
   "end": 49.593,
   "text": "lepas tu satu sudu"
  },
  {
   "start": 49.593,
   "end": 50.853,
   "text": "kecil white peppercorn,"
  },
  {
   "start": 51.027,
   "end": 53.547,
   "text": "lepas tu buah pelaga lebih"
  },
  {
   "start": 53.547,
   "end": 56.307,
   "text": "kurang dalam lima biji macam tu."
  }
 ],
