  {
   "start": 21.927,
   "end": 23.407,
   "text": "Kita nak buat macam ikan bakar"
  },
  {
   "start": 23.407,
   "end": 24.647,
   "text": "yang kita bakar atas arang."
  },
  {
   "start": 24.827,
   "end": 25.607,
   "text": "So kita gunalah"
  },
  {
   "start": 25.607,
   "end": 26.287,
   "text": "fungsi barbecue."
  },
  {
   "start": 26.46,
   "end": 27.72,
   "text": "Tapi kalau kita nak"
  },
  {
   "start": 27.72,
   "end": 28.78,
   "text": "ikan bakar yang macam"
  },
  {
   "start": 28.78,
   "end": 30.34,
   "text": "kita bakar atas pan,"
  },
  {
   "start": 30.527,
   "end": 31.247,
   "text": "yang kita bakar"
