  {
   "start": 18.347,
   "end": 19.647,
   "text": "kita bakar atas arang,"
  },
  {
   "start": 19.827,
   "end": 20.627,
   "text": "kita gunalah barbecue."
  },
  {
   "start": 20.827,
   "end": 21.787,
   "text": "Contoh ikan kan?"
