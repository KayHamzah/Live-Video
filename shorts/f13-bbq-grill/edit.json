  {
   "start": 0.06,
   "end": 2.4,
   "text": "Lepas tu kita ada juga fungsi"
  },
  {
   "start": 2.4,
   "end": 3.82,
   "text": "barbecue dan juga grill."
  },
  {
   "start": 3.993,
   "end": 5.113,
   "text": "Fungsi barbecue dan grill"
  },
  {
   "start": 5.113,
   "end": 6.493,
   "text": "ni dia hampir sama tau."
  },
  {
   "start": 6.733,
   "end": 8.273,
   "text": "Tapi apa yang membezakan?"
  },
  {
