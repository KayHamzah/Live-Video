 "subtitles": [
  {
   "start": 0.06,
   "end": 1.5,
   "text": "Kalau kata kita terlupa nak"
  },
  {
   "start": 1.5,
   "end": 2.96,
   "text": "tutup pun, korang jangan risau."
  },
  {
   "start": 3.16,
   "end": 4.22,
   "text": "Okey minyak ni dia akan"
  },
  {
   "start": 4.22,
   "end": 5.1,
   "text": "maintain je macam ni."
  },
  {
   "start": 5.16,
   "end": 6.38,
   "text": "Dia tidak akan terlalu panas,"
  },
  {
   "start": 6.5,
   "end": 7.46,
   "text": "dia tidak akan berasap."
  },
  {
   "start": 7.627,
   "end": 9.007,
   "text": "So selamatlah contoh kalau"
  },
  {
   "start": 9.007,
   "end": 10.087,
   "text": "macam kita nak suruh anak kita"
  },
  {
   "start": 10.087,
   "end": 11.207,
   "text": "goreng-goreng ke apa kan."
  },
  {
   "start": 11.447,
   "end": 12.487,
   "text": "Lepas tu kita nak"
  },
  {
   "start": 12.487,
   "end": 14.067,
   "text": "tinggalkan dekat rumah."
  },
  {
   "start": 14.347,
   "end": 15.407,
   "text": "Kita tak risau dah."
  },
  {
   "start": 15.467,
   "end": 16.427,
   "text": "Kalau dulu kita risau"
  },
  {
   "start": 16.427,
   "end": 17.267,
   "text": "eh dia ni tutup tak"
  },
  {
   "start": 17.267,
   "end": 18.127,
   "text": "api kat dapur tadi."
  },
  {
   "start": 18.327,
   "end": 20.487,
   "text": "Tapi kalau dia masak"
  },
  {
   "start": 20.487,
   "end": 21.667,
   "text": "guna Cooven kita dah"
  },
  {
   "start": 21.667,
   "end": 22.447,
   "text": "tak perlu risau dah."
  },
  {
   "start": 22.507,
   "end": 23.367,
   "text": "Dia tutup ke tak tutup."
  },
  {
   "start": 23.407,
   "end": 24.127,
   "text": "Kalau dia tak tutup"
  },
  {
   "start": 24.127,
   "end": 25.187,
   "text": "pun dia tinggalkan tak"
  },
  {
   "start": 25.187,
   "end": 25.967,
   "text": "apa tak ada masalah."
  },
  {
   "start": 26.16,
   "end": 27.5,
   "text": "Sebab nanti bila timer"
  },
  {
   "start": 27.5,
   "end": 28.72,
   "text": "tu dah habis dia"
  },
  {
   "start": 28.72,
   "end": 29.88,
   "text": "akan auto switch off."
  },
  {
   "start": 30.06,
   "end": 30.64,
   "text": "Nampak tak?"
  },
  {
   "start": 30.86,
   "end": 31.76,
   "text": "Dia dah habis dah."
  },
  {
   "start": 31.96,
   "end": 32.5,
   "text": "Bila done,"
  },
  {
   "start": 32.693,
   "end": 34.293,
   "text": "dia terus switch off."
  },
  {
