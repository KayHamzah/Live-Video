 "subtitles": [
  {
   "start": 0.06,
   "end": 1.44,
   "text": "Okey, tapi dia juga boleh"
  },
  {
   "start": 1.44,
   "end": 3.3,
   "text": "digunakan untuk merebus."
  },
  {
   "start": 3.493,
   "end": 5.393,
   "text": "Apa beza kalau kita guna fungsi"
  },
  {
   "start": 5.393,
   "end": 6.873,
   "text": "steam dengan fungsi cooker?"
  },
  {
   "start": 7.153,
   "end": 8.313,
   "text": "Fungsi steam kita boleh"
  },
  {
   "start": 8.313,
   "end": 9.793,
   "text": "rebus lebih cepat"
  },
  {
   "start": 9.793,
   "end": 11.073,
   "text": "berbanding fungsi cooker."
  },
  {
   "start": 11.26,
   "end": 12.78,
   "text": "Kalau kita tak sabar kan"
  },
  {
   "start": 12.78,
   "end": 14.02,
   "text": "nak rebus cepat-cepat, kita"
  },
  {
   "start": 14.02,
   "end": 15.08,
   "text": "boleh guna fungsi steam."
  },
  {
   "start": 15.26,
   "end": 16.6,
   "text": "Untuk siapa-siapa yang"
  },
  {
   "start": 16.6,
   "end": 17.52,
   "text": "buat pembelian Cooven"
  },
  {
   "start": 17.52,
   "end": 18.82,
   "text": "cooker, you boleh steam"
  },
  {
   "start": 18.82,
   "end": 20.24,
   "text": "secara tiga layer tau."
  },
  {
   "start": 20.427,
   "end": 22.267,
   "text": "Ni layer atas sekali, kita"
  },
  {
   "start": 22.267,
   "end": 23.227,
   "text": "panggil steaming rack."
  },
  {
   "start": 23.427,
   "end": 24.827,
   "text": "Kita ada medium rack dan juga"
  },
  {
   "start": 24.827,
   "end": 26.627,
   "text": "lower rack yang kita panggil"
  },
  {
   "start": 26.627,
   "end": 27.907,
   "text": "sebagai multi-purpose rack tu."
  },
  {
   "start": 28.093,
   "end": 28.733,
   "text": "Yang tu kita boleh"
  },
  {
   "start": 28.733,
   "end": 29.513,
   "text": "letak dekat bawah."
  },
  {
   "start": 29.733,
   "end": 30.973,
   "text": "So, kita boleh buat tiga"
  },
  {
   "start": 30.973,
   "end": 32.453,
   "text": "layer terus untuk steaming."
  },
  {
   "start": 32.66,
   "end": 34.1,
   "text": "So, kalau macam kita nak steam"
  },
  {
   "start": 34.1,
   "end": 35.64,
   "text": "kuih ke apa kan, kita boleh"
  },
  {
   "start": 35.64,
   "end": 38.7,
   "text": "buat terus sekali 30 biji."
  },
  {
   "start": 38.7,
   "end": 40.82,
   "text": "Lepas tu kalau macam kita"
  },
  {
   "start": 40.82,
   "end": 42.96,
   "text": "nak buat pau tu yang doh 50"
  },
  {
