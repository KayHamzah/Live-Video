 "subtitles": [
  {
   "start": 0.06,
   "end": 3.08,
   "text": "Kita ada juga fungsi deep fry."
  },
  {
   "start": 3.18,
   "end": 4.12,
   "text": "Fungsi deep fry macam yang"
  },
  {
   "start": 4.12,
   "end": 5.32,
   "text": "Kak tunjukkan awal tadi."
  },
  {
   "start": 5.46,
   "end": 6.44,
   "text": "Kita goreng cucur."
  },
  {
   "start": 6.627,
   "end": 7.927,
   "text": "Yang ini adalah cucur"
  },
  {
   "start": 7.927,
   "end": 8.887,
   "text": "jagung gluten free."
  },
  {
   "start": 9.06,
   "end": 10.58,
   "text": "Kalau you all perasan cucur kita"
  },
  {
   "start": 10.58,
   "end": 11.88,
   "text": "ni dia tak berminyak macam"
  },
  {
   "start": 11.88,
   "end": 14.14,
   "text": "kita goreng dekat dalam kuali."
  },
  {
   "start": 14.327,
   "end": 15.907,
   "text": "Lepas tu hasil dia pun"
  },
  {
   "start": 15.907,
   "end": 17.267,
   "text": "cantik, crunchy dekat"
  },
  {
   "start": 17.267,
   "end": 18.467,
   "text": "luar, lembut dekat dalam."
  },
  {
   "start": 18.66,
   "end": 19.88,
   "text": "Dia tak berminyak lah,"
  },
  {
   "start": 19.98,
   "end": 20.82,
   "text": "dia tak resap minyak."
  },
  {
   "start": 21.02,
   "end": 23.44,
   "text": "Lepas tu minyak tak mudah"
  },
  {
   "start": 23.44,
   "end": 25.14,
   "text": "kotor, dia tak melekat and"
  },
  {
   "start": 25.14,
   "end": 26.8,
   "text": "then dia tak ada percikan-percikan"
  },
  {
   "start": 26.8,
   "end": 27.78,
   "text": "dekat tepi-tepi ni."
  },
  {
   "start": 27.78,
   "end": 29.5,
   "text": "So, kuranglah kerja"
  },
  {
   "start": 29.5,
   "end": 30.86,
   "text": "kita nak mengemas"
  },
  {
   "start": 31.027,
   "end": 31.767,
   "text": "Tak payah gigih dah."
  },
  {
   "start": 32.007,
   "end": 35.787,
   "text": "Sebab dia akan auto panaskan"
  },
  {
   "start": 35.787,
   "end": 37.507,
   "text": "kita punya minyak sampai"
  },
  {
   "start": 37.507,
   "end": 39.367,
   "text": "lah keadaan dia dah ready"
  },
  {
   "start": 39.367,
   "end": 41.947,
   "text": "untuk terima makanan barulah"
  },
  {
   "start": 41.947,
   "end": 45.647,
   "text": "dia suruh kita add food."
  },
  {
   "start": 45.827,
   "end": 47.107,
   "text": "Minyak tu tak hitam tau."
  },
  {
   "start": 47.293,
   "end": 48.553,
   "text": "Tu antara kelebihan"
  },
  {
   "start": 48.553,
   "end": 49.073,
   "text": "ni lagi lah."
  },
  {
   "start": 49.26,
   "end": 50.14,
   "text": "So lepas ni kita boleh"
  },
  {
   "start": 50.14,
   "end": 51.06,
   "text": "goreng macam-macam pula."
  },
  {
   "start": 51.26,
   "end": 52.64,
   "text": "So kita boleh recycle lah"
  },
  {
   "start": 52.64,
