 "subtitles": [
  {
   "start": 0.06,
   "end": 1.4,
   "text": "Tarik guna penyepit sahaja."
  },
  {
   "start": 1.593,
   "end": 2.913,
   "text": "Haa nampak tak?"
  },
  {
   "start": 3.093,
   "end": 4.553,
   "text": "Punyalah dia masak"
  },
  {
   "start": 4.553,
   "end": 5.733,
   "text": "sehingga ke tulang."
  },
  {
   "start": 5.927,
   "end": 7.847,
   "text": "Kalau dulu kan masak guna"
  },
  {
   "start": 7.847,
   "end": 9.587,
   "text": "oven untuk ayam bakar seekor"
  },
  {
   "start": 9.587,
   "end": 11.527,
   "text": "macam ni satu jam lebih."
  },
  {
   "start": 11.747,
   "end": 12.847,
   "text": "Nak dekat dua jam."
  },
  {
   "start": 12.967,
   "end": 14.187,
   "text": "Kadang-kadang barulah masak."
  },
  {
   "start": 14.307,
   "end": 16.627,
   "text": "Lepas tu tarik-tarik keras."
  },
  {
   "start": 16.793,
   "end": 17.913,
   "text": "Rupanya tak masak lagi"
  },
  {
   "start": 17.913,
   "end": 18.633,
   "text": "dekat bahagian"
  },
  {
   "start": 18.633,
   "end": 19.693,
   "text": "tulang-tulang pelipat ni."
  },
  {
   "start": 19.893,
   "end": 21.533,
   "text": "So inilah ayam kita"
  },
  {
   "start": 21.533,
   "end": 22.973,
   "text": "sangat lembut tau."
  },
  {
   "start": 23.213,
   "end": 25.193,
   "text": "Dulu kan anak-anak K kalau"
  },
  {
   "start": 25.193,
   "end": 27.093,
   "text": "kata bakar ayam seekor"
  },
  {
   "start": 27.093,
   "end": 28.673,
   "text": "macam ni masa zaman-zaman"
  },
  {
   "start": 28.673,
   "end": 29.873,
   "text": "K pakai oven dulu,"
  },
  {
   "start": 30.06,
   "end": 30.8,
   "text": "dia orang bahagian"
  },
  {
   "start": 30.8,
   "end": 31.98,
   "text": "dada ni tak makan tau."
  },
  {
   "start": 32.16,
   "end": 32.48,
   "text": "Dada."
  },
  {
   "start": 32.66,
   "end": 34.0,
   "text": "Tapi bila kita"
  },
  {
   "start": 34.0,
   "end": 35.46,
   "text": "masak guna Cooven,"
  },
  {
   "start": 35.66,
   "end": 37.07,
   "text": "bahagian dada ni pun dia"
  },
  {
   "start": 37.07,
   "end": 38.12,
   "text": "orang boleh makan sebab"
  },
  {
   "start": 38.12,
   "end": 39.34,
   "text": "bahagian dada ni tak dry."
  },
  {
   "start": 39.527,
   "end": 41.307,
   "text": "Tapi yang ini dah lah boleh"
  },
  {
   "start": 41.307,
   "end": 42.707,
   "text": "masuk dua ekor sekaligus."
  },
  {
   "start": 42.907,
   "end": 44.407,
   "text": "Lepas tu masa nak bakar"
  },
  {
   "start": 44.407,
   "end": 45.427,
   "text": "tu lebih kurang dalam 40"
  },
  {
   "start": 45.427,
   "end": 46.907,
   "text": "minit macam tu dah siap."
  },
  {
   "start": 47.093,
   "end": 48.013,
   "text": "Tak perlu nak tunggu"
  },
  {
   "start": 48.013,
   "end": 48.993,
   "text": "sampai satu jam pun."
  }
 ],
