 "subtitles": [
  {
   "start": 0.06,
   "end": 1.4,
   "text": "Okey tarik guna penyepit"
  },
  {
   "start": 1.4,
   "end": 1.82,
   "text": "sahaja."
  },
  {
   "start": 2.027,
   "end": 3.347,
   "text": "Haa nampak tak?"
  },
  {
   "start": 3.527,
   "end": 5.667,
   "text": "Punyalah dia masak sehingga ke"
  },
  {
   "start": 5.667,
   "end": 6.167,
   "text": "tulang."
  },
  {
   "start": 6.36,
   "end": 8.66,
   "text": "Okey kalau dulu kan masak guna"
  },
  {
   "start": 8.66,
   "end": 10.4,
   "text": "oven untuk ayam bakar seekor"
  },
  {
   "start": 10.4,
   "end": 12.34,
   "text": "macam ni satu jam lebih."
  },
  {
   "start": 12.56,
   "end": 13.66,
   "text": "Nak dekat dua jam."
  },
  {
   "start": 13.78,
   "end": 15.0,
   "text": "Kadang-kadang barulah masak."
  },
  {
   "start": 15.12,
   "end": 17.44,
   "text": "Lepas tu tarik-tarik keras."
  },
  {
   "start": 17.58,
   "end": 18.4,
   "text": "Tarik-tarik keras."
  },
  {
   "start": 18.48,
   "end": 19.9,
   "text": "Rupanya tak masak lagi dekat"
  },
  {
   "start": 19.9,
   "end": 21.24,
   "text": "bahagian tulang-tulang pelipat"
  },
  {
   "start": 21.24,
   "end": 21.38,
   "text": "ni."
  },
  {
   "start": 21.56,
   "end": 22.9,
   "text": "bahagian dada ni tak makan"
  },
  {
   "start": 22.9,
   "end": 23.18,
   "text": "tau."
  },
  {
   "start": 23.36,
   "end": 24.52,
   "text": "Okay dia orang tak makan"
  },
  {
   "start": 24.52,
   "end": 25.16,
   "text": "bahagian dada."
  },
  {
   "start": 25.36,
   "end": 27.36,
   "text": "Tapi bila kita masak guna"
  },
  {
   "start": 27.36,
   "end": 28.1,
   "text": "Cooven,"
  },
  {
   "start": 28.293,
   "end": 30.033,
   "text": "bahagian dada ni pun dia orang"
  },
  {
   "start": 30.033,
   "end": 31.353,
   "text": "boleh makan sebab bahagian"
  },
  {
   "start": 31.353,
   "end": 32.193,
   "text": "dada ni tak dry."
  },
  {
   "start": 32.393,
   "end": 34.173,
   "text": "tapi yang ini dah lah boleh"
  },
  {
   "start": 34.173,
   "end": 35.573,
   "text": "masuk dua ekor sekaligus."
  },
  {
   "start": 35.773,
   "end": 37.413,
   "text": "Lepas tu masa nak bakar tu"
  },
  {
   "start": 37.413,
   "end": 38.693,
   "text": "lebih kurang dalam 40 minit"
  },
  {
   "start": 38.693,
   "end": 39.773,
   "text": "macam tu dah siap."
  },
  {
   "start": 39.96,
   "end": 41.06,
   "text": "Tak perlu nak tunggu sampai"
  },
  {
   "start": 41.06,
   "end": 41.86,
   "text": "satu jam pun."
  }
 ],
